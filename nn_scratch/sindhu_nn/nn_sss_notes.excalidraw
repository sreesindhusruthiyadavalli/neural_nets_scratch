      "seed": 1426681102,
      "version": 338,
      "versionNonce": 1487235794,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783520411047,
      "link": null,
      "locked": false,
      "text": "- vanilla gd : fixed step size , w = w - alpha.dl/dw\n\n- momentum gd: w = w-    dl/dw + mom.factor * prev_weight_avgs\n                  \n                      = w - alpha.(beta1. momentum(t-1) + (1-beta1).dl/dw)\n\n- RMS props : w =w-alpha* dl/dw",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- vanilla gd : fixed step size , w = w - alpha.dl/dw\n\n- momentum gd: w = w-    dl/dw + mom.factor * prev_weight_avgs\n                  \n                      = w - alpha.(beta1. momentum(t-1) + (1-beta1).dl/dw)\n\n- RMS props : w =w-alpha* dl/dw",
      "autoResize": true,
      "lineHeight": 1.25
    },
